# Copy to .env and fill in. The app runs without Alpaca keys using synthetic data.

# Alpaca (optional). Free SIP/IEX key from https://alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_FEED=sip

# Auth is off by default. Set AUTH_ENABLED=true to require login.
AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=dev-secret-change-me

STARTING_CASH=100000
RISK_FREE_RATE=0.04
STOCK_SLIPPAGE_BPS=1.0
OPTION_SLIPPAGE_PCT=0.01
OPTION_COMMISSION_PER_CONTRACT=0.65
